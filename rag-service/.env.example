# 本地向量 RAG 服务配置。复制为 .env 后再填写实际值。
RAG_HOST=127.0.0.1
RAG_PORT=8090

# 模型首次实际运行时才会下载；本步骤不会下载。
RAG_MODEL_NAME=intfloat/multilingual-e5-small

# FAISS 索引与元数据均保存在本机。
RAG_DATA_DIR=./data

# 与 Spring Boot 使用同一 MySQL 数据库。
RAG_MYSQL_HOST=127.0.0.1
RAG_MYSQL_PORT=3306
RAG_MYSQL_DATABASE=springweb_demo
RAG_MYSQL_USERNAME=root
RAG_MYSQL_PASSWORD=
