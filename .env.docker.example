# Copy this file to .env before the first Docker startup.
MYSQL_ROOT_PASSWORD=change_this_database_password
#此处apikey不需要加冒号
# DeepSeek uses an OpenAI-compatible API.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-v4-flash

# Qwen OpenAI-compatible API. Keep the key only in your local .env.
QWEN_API_KEY=
QWEN_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
AGENT_PORT=8100
AGENT_TOOL_KEY=
AGENT_TOOL_MAX_ATTEMPTS=2
AGENT_TOOL_PARALLEL_MAX_WORKERS=4
AGENT_TOOL_RETRY_BACKOFF_SECONDS=0.1
AGENT_TOOL_CIRCUIT_FAILURE_THRESHOLD=3
AGENT_TOOL_CIRCUIT_RECOVERY_SECONDS=30
AGENT_AUDIT_RETENTION_DAYS=30

# Host ports can be changed when they conflict with other software.
FRONTEND_PORT=8081
BACKEND_PORT=8082
RAG_PORT=8090
MYSQL_PORT=3306

RAG_MODEL_NAME=intfloat/multilingual-e5-small
RAG_EMBEDDING_CACHE_TTL_SECONDS=600
RAG_EMBEDDING_CACHE_MAX_ENTRIES=512
RAG_SEARCH_CACHE_TTL_SECONDS=120
RAG_SEARCH_CACHE_MAX_ENTRIES=256
VECTOR_RAG_SEARCH_CACHE_TTL_MS=60000
PROMPT_CACHE_TTL_MS=30000
PROMPT_EVALUATION_CACHE_TTL_MS=300000

# Per-user request throttling and daily external-model budget defaults.
LLM_QUOTA_REQUESTS_PER_MINUTE=20
LLM_QUOTA_CONCURRENT_STREAMS=2
LLM_QUOTA_DAILY_TOKEN_LIMIT=100000
LLM_QUOTA_DAILY_COST_LIMIT=10.0

# Nightly retrieval regression and alert thresholds.
REGRESSION_SCHEDULE_ENABLED=true
REGRESSION_SCHEDULE_CRON="0 0 3 * * *"
REGRESSION_TOP_K=5
REGRESSION_ACCURACY_DROP=0.05
REGRESSION_RECALL_DROP=0.05
REGRESSION_LATENCY_INCREASE_RATIO=0.50
